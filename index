  $("habits").innerHTML=F.map(function(f){var s=a.st[f.id]||"ok";
    return '<div class="hab"><span>'+f.label+'</span><b>'+d.v[f.id]+f.unit+'</b><div class="t"><i style="width:'+a.pct[f.id]+'%;background:'+COL[s]+'"></i></div></div>'}).join("");
  var lab={danger:"Critical",warn:"Watch",ok:"On track"};
  $("warnings").innerHTML=a.W.map(function(w){return '<div class="w '+w.s+'"><b><em>'+lab[w.s]+'</em>'+w.t+'</b><p>'+w.m+'</p></div>'}).join("");
}


function renderRoster(){
  var t=activeTeacher();if(!t)return;
  var R=(read("pp_roster")||[]).filter(function(s){return collegeKey(s.school)===collegeKey(t.college)});
  var all=R.map(function(s){return {s:s,a:analyse(s.v)}});
  var sum=all.reduce(function(t,x){return t+x.a.pred},0);
  var crit=all.reduce(function(t,x){return t+x.a.W.filter(function(w){return w.s==="danger"}).length},0);
  $("sCount").textContent=all.length;
  $("sAvg").textContent=all.length?Math.round(sum/all.length):"0";
  $("sRisk").textContent=all.filter(function(x){return x.a.pred<55}).length;
  $("sCrit").textContent=crit;
  var rows=all.slice();
  if($("flt").value==="risk")rows=rows.filter(function(x){return x.a.pred<55});
  rows.sort(function(a,b){return a.a.pred-b.a.pred});
  var tb=$("rbody");tb.textContent="";
  rows.forEach(function(x){
    var b=band(x.a.pred),tr=el("tr");
    tr.appendChild(el("td","",x.s.name));
    var t2=el("td");t2.appendChild(el("b","",x.a.pred+" ("+b.g+")"));tr.appendChild(t2);
    var t3=el("td");var bd=el("span","badge",b.lab);bd.style.color=b.c;bd.style.background=b.bg;t3.appendChild(bd);tr.appendChild(t3);
    tr.appendChild(el("td","",String(x.a.W.filter(function(w){return w.s==="danger"}).length)));
    tr.appendChild(el("td","",x.a.W[0].s==="ok"?"None":x.a.W[0].t));
    var t6=el("td");var rm=el("button","","Remove");rm.style.padding="4px 10px";
    rm.addEventListener("click",function(){store("pp_roster",(read("pp_roster")||[]).filter(function(r){return r.id!==x.s.id}));renderRoster()});
    t6.appendChild(rm);tr.appendChild(t6);tb.appendChild(tr);
  });
  $("rempty").hidden=all.length>0;
}

